#include <bits/stdc++.h>
using namespace std;

int main(){
    ios::sync_with_stdio(0);
    cin.tie(0);/enhance the cin&cout efficiency./
    int n;
    while (cin>>n) {
        if (n==0) {
            break;
        }/input ends with zero./
        int sum=0;
        vector<int> vertices(n);
        for (int i=0;i<n;i++) {
            cin>>vertices[i];/getting the numbers of edges that a vertex has./
            sum+=vertices[i];
        }
        if (sum%2!=0) {
            cout<<'N'<<"\n";/the sum of the edges need to be an even number./
            continue;
        }
        bool finished=false;
        while (true) {
            sort(vertices.rbegin(),vertices.rend());/sort the vector from big to small./
            if (vertices[0]==0) {
                cout<<"Y"<<"\n";/if the biggest number is zero, the other numbers are also zero./
                break;
            }
            if (vertices[0]>=n) {
                cout<<"N"<<"\n";/the edges can't be greater than the length of vector./
                break;
            }
            for (int i=1;i<=vertices[0];i++) {/using Havel-Hakimi algorithm/
                vertices[i]--;
                if (vertices[i]<0) {
                    cout<<"N"<<"\n";/too many edges/
                    finished=true;
                    break;
                }
            }
            vertices[0]=0;
            if (finished) {
                break;
            }
        }
    }
    return 0;
}
